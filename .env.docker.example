# ==============================================================================
# Retriever — Docker Compose Environment Template
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Connection (pgvector container)
DATABASE_URL=postgresql+asyncpg://retriever:retriever@postgres:5432/retriever
POSTGRES_USER=retriever
POSTGRES_PASSWORD=retriever
POSTGRES_DB=retriever

# Redis Cache & Sliding-Window Token Shield
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

# Local Ollama Embeddings (Zero external API costs)
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# Master Admin Key & Security Secrets
ADMIN_MASTER_KEY=ret_live_master_admin_secret_0000000000000
SECRET_KEY=retriever-local-dev-secret-key-32-chars-long-min
KEY_ENCRYPTION_KEY=dGVzdC1lbmNyeXB0aW9uLWtleS0zMi1ieXRlcy1sb25nIQ==
STORAGE_PROVIDER=local
STORAGE_BUCKET=retriever-documents

# Network & CORS
CORS_ORIGINS=*
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional External Cloud LLM Providers (BYOK for Chat Synthesis & RAG Generation)
# By default, Retriever uses $0 local Ollama models. Uncomment and set if you prefer cloud models:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
