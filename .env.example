# ==============================================================================
# RETRIEVER PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (PostgreSQL with pgvector)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/retriever_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Master Keys
ADMIN_MASTER_KEY="super-secret-admin-master-key-change-in-production"
SECRET_KEY="generate-a-secure-random-64-character-hex-secret-for-jwt"
KEY_ENCRYPTION_KEY="dev-key-encryption-key-must-be-32-bytes-long="
BACKUP_ENCRYPTION_KEY="custom-aes256-backup-encryption-key-or-uses-key-encryption-key"

# ==============================================================================
# MULTI-REGION READ-REPLICAS & EDGE ROUTING (M89)
# ==============================================================================
# Primary Master region (default: "ap-south" for Mumbai/Singapore Hub)
PRIMARY_REGION="ap-south"

# Optional Read-Replica connection poolers for sub-30ms global lookups.
# If omitted or left commented, queries automatically fallback to PRIMARY_REGION with $0 extra cost.
# REPLICA_US_EAST_DATABASE_URL="postgresql+asyncpg://postgres:secret@us-east-pooler.supabase.com:5432/retriever_db"
# REPLICA_EU_CENTRAL_DATABASE_URL="postgresql+asyncpg://postgres:secret@eu-central-pooler.supabase.com:5432/retriever_db"
# REPLICA_AP_SOUTH_DATABASE_URL=""

# ==============================================================================
# DISASTER RECOVERY & OBJECT STORAGE (M87)
# ==============================================================================
# By default, STORAGE_PROVIDER is "local" (backups saved to LOCAL_BACKUP_DIR).
# To enable off-site cloud replication (Cloudflare R2, AWS S3, or MinIO), set:
STORAGE_PROVIDER="local"
STORAGE_BUCKET="retriever-backups"
LOCAL_BACKUP_DIR="/tmp/retriever/backups"

# --- Cloudflare R2 / AWS S3 Configuration (Optional) ---
# S3_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
# AWS_ACCESS_KEY_ID="your-s3-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-s3-secret-access-key"
# AWS_REGION="auto"

# ==============================================================================
# LOCAL AI EMBEDDINGS (OLLAMA - $0 COST)
# ==============================================================================
OLLAMA_BASE_URL="http://localhost:11434"
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_DIMENSION=768

# ==============================================================================
# OPTIONAL EXTERNAL LLM PROVIDERS (BYOK)
# ==============================================================================
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# COHERE_API_KEY=""
# TAVILY_API_KEY=""

# ==============================================================================
# CONFIDENTIAL MICRO-ENCLAVE & HARDWARE ATTESTATION (M101)
# ==============================================================================
# Optional static 32-byte secret for confidential micro-enclave root key derivation.
# If omitted or empty, automatically derives from the hardware node machine identity.
# ENCLAVE_ROOT_SEED="generate-a-secure-random-64-character-hex-seed"

