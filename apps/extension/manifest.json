{
  "manifest_version": 3,
  "name": "Retriever AI - 1-Click Knowledge Ingestion",
  "version": "1.0.0",
  "description": "Ingest articles, documentation, and web pages directly into your Retriever RAG workspace.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Retriever"
  },
  "background": {
    "service_worker": "background.js"
  }
}
